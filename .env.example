# ============================================================
# AI-Setu Business CRM — Environment Variables (example)
# Copy this file to ".env" and fill in your real values.
# ============================================================

# ----- Ports -----
FRONTEND_PORT=5174
BACKEND_PORT=8000

# ----- Database (MongoDB) -----
MONGODB_URL=mongodb://localhost:27017/ai_setu_crm
MONGODB_DB_NAME=ai_setu_crm

# ----- App -----
APP_ENV=development
APP_NAME=AI-Setu CRM
SECRET_KEY=change-me
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ----- Cross-domain cookies (production: Vercel frontend + Render backend) -----
# Local dev: lax / false. Production split-domain: none / true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ----- JWT / Auth -----
JWT_SECRET_KEY=change-me-to-a-long-random-32+char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Google OAuth (optional) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Email (Resend, optional) -----
RESEND_API_KEY=
EMAIL_FROM=noreply@localhost.com

# ----- Cloudinary (optional) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- AI providers (optional) -----
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# Meta (Facebook / Instagram) Lead Ads integration
# ============================================================
# Credentials are now configured PER-ORGANIZATION from the app UI:
#   Settings → Integrations → Meta Lead Ads
# They are encrypted at rest using ENCRYPTION_KEY (above). There are no
# Meta credential env vars anymore. Only the default Graph API version is here.
META_GRAPH_VERSION=v19.0
